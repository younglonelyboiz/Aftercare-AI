# ==============================================================================
# AFTERCARE-AI ENVIRONMENT CONFIGURATION
# Sao chép file này thành .env và điền thông tin tương ứng:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. OPENROUTER API (Mô hình Chatbot Aftercare: GPT-4o, Claude, Gemini...)
# Lấy API key tại: https://openrouter.ai/settings/keys
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-YourActualOpenRouterApiKeyHere
OPENROUTER_MODEL=openai/gpt-4o
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI API (Dự phòng khi không dùng OpenRouter)
# Lấy API key tại: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSyYourActualGeminiApiKeyHere
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 2. LOCAL EMBEDDING MODEL (BAAI/bge-m3)
# ------------------------------------------------------------------------------
# Model đa ngữ Anh - Việt chuyên sâu y tế, vector dense 1024 chiều
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
# Thiết bị chạy model: "cuda" (GPU) hoặc "cpu"
EMBEDDING_DEVICE=cuda

# ------------------------------------------------------------------------------
# 3. POSTGRESQL & PGVECTOR DATABASE
# ------------------------------------------------------------------------------
# Cấu hình kết nối cơ sở dữ liệu PostgreSQL đã bật extension vector
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aftercare_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here

# Tên bảng lưu trữ tri thức RAG
PGVECTOR_TABLE_NAME=medical_knowledge_chunks

# ------------------------------------------------------------------------------
# 4. HUGGING FACE TOKEN (Tùy chọn - Tăng tốc độ tải mô hình)
# ------------------------------------------------------------------------------
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
